{
  "name": "dataagent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "author": "DataAgent",
  "description": "游戏团队的 AI 数据分析工作台",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.js",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js desktop/*.test.cjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir --win --x64 --publish never",
    "desktop:build": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
